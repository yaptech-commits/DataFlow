# Paystack secret key (from https://dashboard.paystack.com/#/settings/developer)
# Use the TEST key while building, LIVE key only once you've tested real charges
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Port the server listens on (Render/Railway set this automatically in production)
PORT=4000

# Comma-separated list of origins allowed to call this API (your deployed frontend URL)
ALLOWED_ORIGIN=https://your-dataflow-site.netlify.app

# --- Data bundle delivery provider: IceKash Consult ---
# Get this from your IceKash dashboard. NEVER commit this file with a real
# key in it — .env should be in .gitignore.
ICEKASH_API_KEY=np_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Pricing ---
# Your own margin over IceKash's cost, applied to every sale (direct or via agent).
PLATFORM_MARKUP_PERCENT=30

# Suggested starting markup for newly registered agents. They can change their
# own later via PATCH /api/agents/:code/markup.
DEFAULT_AGENT_MARKUP_PERCENT=25

# --- Database ---
# Path to the SQLite file that stores agents, purchases, sessions, and
# withdrawals. On Render/Railway, point this at a file inside a persistent
# disk/volume you attach to the service — otherwise a redeploy wipes it.
DATABASE_PATH=/data/dataflow.db
